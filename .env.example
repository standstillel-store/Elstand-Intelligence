# Elstand Intelligence: environment variables
#
# NOTHING in this file is required. With no variables at all the application still starts and
# renders, and every panel that needs provider data shows the exact text ENV NOT CONNECTION,
# followed by a sentence naming the variable that is missing.
# Elstand ships no sample, simulated or placeholder data.
#
# A variable that exists is not a connection: a provider is called connected only after a real
# request to it has been answered and validated (the provider status page, #/providers).
#
# For local development copy this file to .env.local (git-ignored) and uncomment what you need.
# On Vercel, set the same names in the project's Settings, Environment Variables, and redeploy.
# Never commit real values.
#
# Every variable below is read ONLY by the server (api/*, `npm run dev`, `npm run preview`).
# None is ever sent to the browser, and the build fails if a secret value reaches the bundle.
# See docs/ENVIRONMENT.md for what each one does, each provider's limits and terms, and the
# first-connection checklist.

# --- Forex market data: Twelve Data (quotes and candles) ---------------------------------------

# Secret. Your Twelve Data API key. Without it the app shows ENV NOT CONNECTION.
# TWELVE_DATA_API_KEY=

# Set to true ONLY if your Twelve Data plan delivers real-time forex quotes. Then fresh data is
# labelled LIVE. Anything else (the default) labels data DELAYED. The app never assumes real-time.
# ELSTAND_FEED_REALTIME=false

# Seconds between refreshes (server cache lifetime and browser polling). Default 60, clamped to
# the range 10 to 3600.
# ELSTAND_REFRESH_SECONDS=60

# Elstand's own request budget for Twelve Data. The defaults are the Basic plan (8 a minute, 800 a
# day). Set them to what YOUR plan allows. Whole numbers only.
# TWELVE_DATA_CREDITS_PER_MINUTE=8
# TWELVE_DATA_CREDITS_PER_DAY=800

# --- Forex fallback: Alpha Vantage (daily candles and spot quotes only) ------------------------

# Secret. Used only when Twelve Data cannot answer. Never for intraday candles or real-time.
# ALPHA_VANTAGE_API_KEY=

# --- Macro observations ------------------------------------------------------------------------

# Secret. FRED key: 32 lowercase letters and digits. Policy rates and inflation indices.
# FRED_API_KEY=

# Secret, OPTIONAL. BLS registration key. Without it the keyless version 1 is used (25 queries a day).
# BLS_API_KEY=

# Secret. BEA key. U.S. GDP growth.
# BEA_API_KEY=

# Optional address overrides for providers that need no key. Leave empty to use the official
# address. An override must be an https address with no credentials, query or fragment.
# WORLD_BANK_API_BASE_URL=

# Reserved. No supported public IMF endpoint has been verified, so this changes nothing.
# IMF_API_BASE_URL=

# --- Economic calendar, news and reference rates -----------------------------------------------

# Secret, OPTIONAL. Finance Calendar key. Without it the calendar uses its keyless allowance.
# FINANCE_CALENDAR_API_KEY=

# Secret. Marketaux key. Financial news headlines.
# MARKETAUX_API_KEY=

# Optional address override for Frankfurter (daily ECB reference rates).
# FRANKFURTER_API_BASE_URL=

# --- How long answers are kept on the server, in seconds ---------------------------------------

# Longer means fewer requests to a provider with a small allowance. Whole numbers only.
# Calendar: default 900, range 300 to 86400. News: default 1800, range 300 to 86400.
# Macro series: default 21600, range 900 to 604800. Reference rates: default 3600, range 900 to 604800.
# ELSTAND_TTL_CALENDAR_SECONDS=900
# ELSTAND_TTL_NEWS_SECONDS=1800
# ELSTAND_TTL_MACRO_SECONDS=21600
# ELSTAND_TTL_RATES_SECONDS=3600
